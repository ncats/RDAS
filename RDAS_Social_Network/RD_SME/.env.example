# Copy to .env, fill in locally, and never commit .env.
GARD_ID=GARD:0006233
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Full pipeline requires local access to the approved model snapshot.
EXPERTISE_MODEL_PATH=
EMBEDDING_MODEL=sentence-transformer
EMBEDDING_PROCESSES=1
TENSOR_PARALLEL_SIZE=1
# Optional: location extraction requires a licensed city lookup CSV.
USCITIES_CSV=

# Needed only for the optional graph import scripts.
GRAPH_URI=
GRAPH_USER=
GRAPH_PASSWORD=
